# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Values containing "replace_me" are rejected at startup on purpose.

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

# --- GitHub (v1: Personal Access Token) ---
# Fine-grained PAT with: Pull requests (read/write), Contents (read), Metadata (read)
GITHUB_TOKEN=replace_me
# >= 16 chars; must match the secret configured on the GitHub webhook
GITHUB_WEBHOOK_SECRET=replace_me

# --- Gemini (free tier) ---
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash
# Conservative defaults below published free-tier limits; check your AI Studio quota page.
GEMINI_RPM_LIMIT=8
GEMINI_TPM_LIMIT=200000
GEMINI_RPD_LIMIT=200
QUOTA_MAX_WAIT_S=90

# --- Redis ---
# Inside docker-compose this is overridden to redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REVIEW_CACHE_TTL_S=604800

# --- Agent budgets / guardrails ---
PROMPT_VERSION=1
MAX_CONTEXT_TOKENS=6000
MAX_CALLERS=3
MAX_LLM_CALLS_PER_JOB=6
# Hard-capped at 2 by config validation
MAX_RETRIES=2
MAX_PR_CHANGED_LINES=1500
REPRO_MIN_CONFIDENCE=0.7

# --- Sandbox (values above hard caps are rejected) ---
SANDBOX_IMAGE=pr-agent-sandbox-python:3.11
SANDBOX_TIMEOUT_S=120
SANDBOX_MEM_LIMIT=512m
SANDBOX_NANO_CPUS=1000000000
SANDBOX_PIDS_LIMIT=128
SANDBOX_LOG_MAX_BYTES=65536
